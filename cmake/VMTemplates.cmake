# Keep lowering semantics tied to the bundled Lua revision. No Python or
# source-tree files are needed by the installed converter.
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${PROJECT_SOURCE_DIR}/lua/lua/lvm.c")
file(READ "${PROJECT_SOURCE_DIR}/lua/lua/lvm.c" LUA2C_VM_SOURCE)
function(lua2c_slice begin end output)
    string(FIND "${LUA2C_VM_SOURCE}" "${begin}" first)
    string(FIND "${LUA2C_VM_SOURCE}" "${end}" last)
    if(first LESS 0 OR last LESS first)
        message(FATAL_ERROR "Bundled Lua VM template markers changed")
    endif()
    math(EXPR length "${last} - ${first}")
    string(SUBSTRING "${LUA2C_VM_SOURCE}" ${first} ${length} text)
    set(${output} "${text}" PARENT_SCOPE)
endfunction()
lua2c_slice("static int forlimit (" "void luaV_finishget (" loops)
lua2c_slice("static void pushclosure (" "void luaV_finishOp (" closures)
lua2c_slice("#define l_addi(" "/* fetch an instruction" macros)
lua2c_slice("#define NBM" "static int l_strton (" numeric_limits)
lua2c_slice("l_sinline int LTintfloat (" "static int lessthanothers (" numeric_compare)
set(LUA2C_VM_SUPPORT "${numeric_limits}\n${numeric_compare}\n${loops}\n${closures}\n${macros}")
string(LENGTH "${LUA2C_VM_SOURCE}" vm_length)
set(vm_offset 0)
set(LUA2C_VM_LITERAL "std::string()")
while(vm_offset LESS vm_length)
    math(EXPR piece_length "${vm_length} - ${vm_offset}")
    if(piece_length GREATER 8000)
        set(piece_length 8000)
    endif()
    string(SUBSTRING "${LUA2C_VM_SOURCE}" ${vm_offset} ${piece_length} piece)
    string(APPEND LUA2C_VM_LITERAL " + R\"lua2c_vm(${piece})lua2c_vm\"")
    math(EXPR vm_offset "${vm_offset} + ${piece_length}")
endwhile()
file(MAKE_DIRECTORY "${PROJECT_BINARY_DIR}/generated")
configure_file("${PROJECT_SOURCE_DIR}/cmake/vm_templates.hpp.in"
    "${PROJECT_BINARY_DIR}/generated/vm_templates.hpp" @ONLY)
configure_file("${PROJECT_SOURCE_DIR}/runtime/lua2c_vm.h.in"
    "${PROJECT_BINARY_DIR}/generated/lua2c_vm.h" @ONLY)
