function(run)
    execute_process(COMMAND ${ARGV}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Strip CLI command failed: ${ARGV}\n${status}\n${output}\n${error}")
    endif()
    set(result "${output}" PARENT_SCOPE)
endfunction()

get_filename_component(directory "${OUTPUT}" DIRECTORY)
get_filename_component(stem "${OUTPUT}" NAME_WE)
set(header "${directory}/${stem}.h")
set(bytecode "${directory}/${stem}.luac")
set(stripped_bytecode "${directory}/${stem}_stripped.luac")
run("${LUAC}" -o "${bytecode}" "${INPUT}")
run("${LUAC}" -s -o "${stripped_bytecode}" "${INPUT}")
run("${CLI}" "${stripped_bytecode}")
set(reference "${result}")
foreach(flag --strip -s)
    foreach(input "${INPUT}" "${bytecode}" "${stripped_bytecode}")
        run("${CLI}" "${flag}" "${input}")
        if(NOT result STREQUAL reference)
            message(FATAL_ERROR "${flag} differs from luac -s for ${input}")
        endif()
    endforeach()
endforeach()

run("${CLI}" --header --module strip_module --main-name run_stripped -o "${OUTPUT}" "${INPUT}")
file(READ "${OUTPUT}" normal)
file(READ "${header}" declarations)
run("${CLI}" --strip --header --module strip_module --main-name run_stripped -o "${OUTPUT}" "${INPUT}")
file(READ "${OUTPUT}" stripped)
file(READ "${header}" stripped_declarations)
if(normal STREQUAL stripped OR NOT declarations STREQUAL stripped_declarations OR
   NOT stripped MATCHES "int run_stripped\\(lua_State \\*L\\)" OR
   NOT stripped MATCHES "return run_stripped\\(L\\);")
    message(FATAL_ERROR "Stripping did not remove debug info or changed public entry points")
endif()
foreach(symbol lua2c_lines_ lua2c_abslines_ lua2c_locals_ lua2c_gen_add_)
    string(FIND "${stripped}" "${symbol}" position)
    if(NOT position EQUAL -1)
        message(FATAL_ERROR "Stripped output retains ${symbol}")
    endif()
endforeach()

file(WRITE "${bytecode}" "invalid bytecode")
execute_process(COMMAND "${CLI}" --strip --bytecode --header -o "${OUTPUT}" "${bytecode}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT output STREQUAL "" OR error STREQUAL "")
    message(FATAL_ERROR "Strip CLI accepted invalid bytecode: ${status}\n${output}\n${error}")
endif()
file(READ "${OUTPUT}" after_error)
file(READ "${header}" header_after_error)
if(NOT after_error STREQUAL stripped OR NOT header_after_error STREQUAL declarations)
    message(FATAL_ERROR "Invalid strip input overwrote C/header files")
endif()
