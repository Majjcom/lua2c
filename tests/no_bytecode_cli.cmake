function(run)
    execute_process(COMMAND ${ARGV}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "No-bytecode CLI failed: ${ARGV}\n${status}\n${output}\n${error}")
    endif()
    set(result "${output}" PARENT_SCOPE)
endfunction()

get_filename_component(directory "${OUTPUT}" DIRECTORY)
get_filename_component(stem "${OUTPUT}" NAME_WE)
set(header "${directory}/${stem}.h")
set(bytecode "${directory}/${stem}.luac")
set(stripped "${directory}/${stem}_stripped.luac")
run("${LUAC}" -o "${bytecode}" "${INPUT}")
run("${LUAC}" -s -o "${stripped}" "${INPUT}")
foreach(strip OFF ON)
    set(options --no-bytecode --main-name run_native --module native)
    if(strip)
        list(APPEND options --strip)
    endif()
    run("${CLI}" ${options} --source "${INPUT}")
    set(reference "${result}")
    if(reference MATCHES "lua2c_code_" OR NOT reference MATCHES "lua2c_resume_")
        message(FATAL_ERROR "No-bytecode output contains instructions or lacks resume handlers")
    endif()
    run("${CLI}" ${options} --bytecode "${bytecode}")
    if(NOT result STREQUAL reference)
        message(FATAL_ERROR "No-bytecode CLI source/bytecode mismatch")
    endif()
    if(strip)
        run("${CLI}" ${options} "${stripped}")
        if(NOT result STREQUAL reference)
            message(FATAL_ERROR "No-bytecode CLI pre-stripped input mismatch")
        endif()
    endif()
    run("${CLI}" ${options} --header -o "${OUTPUT}" "${INPUT}")
    file(READ "${OUTPUT}" generated)
    file(READ "${header}" declarations)
    if(NOT generated STREQUAL reference OR NOT declarations MATCHES "int run_native\\(lua_State \\*L\\);")
        message(FATAL_ERROR "No-bytecode file/header mismatch")
    endif()
endforeach()
file(WRITE "${bytecode}" "invalid bytecode")
execute_process(COMMAND "${CLI}" --no-bytecode --strip --bytecode --header -o "${OUTPUT}" "${bytecode}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(status EQUAL 0 OR NOT output STREQUAL "" OR error STREQUAL "")
    message(FATAL_ERROR "No-bytecode CLI accepted invalid input")
endif()
file(READ "${OUTPUT}" after_error)
file(READ "${header}" header_after_error)
if(NOT after_error STREQUAL generated OR NOT header_after_error STREQUAL declarations)
    message(FATAL_ERROR "Invalid no-bytecode input overwrote outputs")
endif()
